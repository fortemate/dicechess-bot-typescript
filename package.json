{
  "name": "dicechess-bot-typescript",
  "version": "1.0.0",
  "description": "TypeScript starter for Dice Chess bots with a shared authenticated webhook runtime.",
  "type": "module",
  "main": "dist/functions/*.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fortemate/dicechess-bot-typescript.git"
  },
  "homepage": "https://fortemate.com",
  "bugs": {
    "url": "https://github.com/fortemate/dicechess-bot-typescript/issues"
  },
  "engines": {
    "node": ">=22.23.3 <23 || >=24.21.0 <25 || >=26.8.2 <27"
  },
  "scripts": {
    "start": "tsx src/bot.ts",
    "webhook": "tsx src/webhook-server.ts",
    "claim-identity": "tsx src/claim-identity.ts",
    "ladder:join": "tsx src/join-ladder.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/webhook.test.ts src/strategy.test.ts",
    "func:start": "func start"
  },
  "keywords": [
    "dicechess",
    "chess",
    "bot",
    "typescript",
    "starter-template",
    "azure-functions"
  ],
  "author": "Jegors Čemisovs",
  "license": "MIT",
  "dependencies": {
    "@azure/functions": "^4.16.5",
    "@fortemate/dicechess-bot-runtime": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
